<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  
  <Package Name="Applivery SOAR Agent" Manufacturer="Applivery" Version="1.0.0.0" UpgradeCode="a138cf96-14fb-4f92-bfe3-0aba460a6275" Scope="perMachine">
    
    <!-- AllowSameVersionUpgrades: this repo's CI never bumps Package
         Version="1.0.0.0" above — every push publishes new binary content
         under the same version string (the same "rolling latest build,
         content-addressed not version-addressed" model already used for
         Applivery asset dedup elsewhere in this project). Without this
         attribute, Windows Installer treats a same-version reinstall as
         "already installed, nothing to do" and silently skips replacing the
         files — a UEM re-push (or a manual re-run of the same MSI) would
         leave the OLD binary running indefinitely with no error anywhere.
         With it, MajorUpgrade's uninstall-old/install-new sequence runs
         even when ProductVersion is unchanged, so every push actually takes
         effect. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Applivery SOAR Agent">

        <!-- Declared BEFORE AgentExecutable below deliberately: WiX schedules
             each component's ServiceControl Stop/Start rows into the standard
             StopServices/StartServices actions in component-declaration
             order, so this ordering makes the real sequence
             "stop watchdog, stop agent, [replace files], start agent, start
             watchdog" on every install/upgrade/uninstall. That matters
             because these two services watch each other (svcwatch package,
             internal/svcwatch/svcwatch.go) and restart their partner if it's
             found stopped — if MSI stopped the agent first while the
             watchdog was still running and still polling, the watchdog could
             restart the (about to be overwritten) agent exe mid-upgrade,
             re-locking a file MSI is trying to replace. Stopping the
             watchdog first removes the one thing that would otherwise fight
             the installer. -->
        <Component Id="WatchdogExecutable" Bitness="always64">
          <File Id="AppliverySOARWatchdogExe" Source="Applivery-SOAR-Watchdog.exe" KeyPath="yes" />

          <ServiceInstall
            Id="WatchdogServiceInstaller"
            Type="ownProcess"
            Name="AppliverySOARWatchdog"
            DisplayName="Applivery SOAR Watchdog"
            Description="Monitors the Applivery SOAR Agent service and restarts it if it stops unexpectedly."
            Start="auto"
            Account="LocalSystem"
            ErrorControl="normal" />

          <ServiceControl
            Id="WatchdogServiceControl"
            Start="install"
            Stop="both"
            Remove="uninstall"
            Name="AppliverySOARWatchdog"
            Wait="yes" />
        </Component>

        <Component Id="AgentExecutable" Bitness="always64">
          <File Id="AppliverySOARAgentExe" Source="Applivery-SOAR-Agent.exe" KeyPath="yes" />

          <ServiceInstall
            Id="ServiceInstaller"
            Type="ownProcess"
            Name="AppliverySOARAgent"
            DisplayName="Applivery SOAR Agent"
            Description="Reports device telemetry (BitLocker, Firewall, Apps) to the Applivery SOAR platform."
            Start="auto"
            Account="LocalSystem"
            ErrorControl="normal" />

          <ServiceControl
            Id="StartService"
            Start="install"
            Stop="both"
            Remove="uninstall"
            Name="AppliverySOARAgent"
            Wait="yes" />

        </Component>

        <!-- Not a service — see tray/main.go's package doc for why: services
             run in Session 0 and can never show UI in a user's desktop
             session. RegisterTrayTask/UnregisterTrayTask below (
             InstallExecuteSequence) register a Scheduled Task instead, so
             this exe launches once any user logs on. -->
        <Component Id="TrayExecutable" Bitness="always64">
          <File Id="AppliverySOARTrayExe" Source="Applivery-SOAR-Tray.exe" KeyPath="yes" />
        </Component>

      </Directory>
    </StandardDirectory>

    <!-- schtasks.exe is the standard way to register a per-logon Scheduled
         Task from a WiX v4 installer — there's no native <ScheduledTask>
         element in WiX v4's core schema. /RU "Users" scopes the ONLOGON
         trigger to the built-in local "Users" group (i.e. any interactively
         logged-on user), not just whichever account happens to run this
         deferred custom action (which executes elevated, as the installer
         service — without /RU it would otherwise register a task tied to
         that account instead of "any user"). /RL LIMITED runs the tray
         helper with standard-user rights, matching what a tray icon needs
         (read a status file, show a menu, open a browser — nothing that
         needs elevation). -->
    <CustomAction Id="RegisterTrayTask"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[System64Folder]schtasks.exe&quot; /Create /SC ONLOGON /TN &quot;Applivery SOAR Tray&quot; /TR &quot;\&quot;[INSTALLFOLDER]Applivery-SOAR-Tray.exe\&quot;&quot; /RU &quot;Users&quot; /RL LIMITED /F"
      Execute="deferred"
      Impersonate="no"
      Return="check" />

    <CustomAction Id="UnregisterTrayTask"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[System64Folder]schtasks.exe&quot; /Delete /TN &quot;Applivery SOAR Tray&quot; /F"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <!-- Neither ServiceControl (that's only for the two actual Windows
         services) nor RegisterTrayTask (which only redefines the Scheduled
         Task, it doesn't invoke it) stops or restarts the tray helper —
         without this, an upgrade silently leaves the OLD Tray.exe process
         running its old in-memory code (Windows lets the installer
         overwrite/delete a still-open exe; the running process itself never
         notices) until the user happens to log off and back on. Scheduled
         unconditionally below (see InstallExecuteSequence) so it also runs
         on a plain uninstall/repair, not just an upgrade; taskkill's return
         code is ignored since it exits non-zero whenever the process simply
         isn't running (a fresh install, or the tray already closed), which
         isn't a real failure. -->
    <CustomAction Id="StopTrayProcess"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[System64Folder]taskkill.exe&quot; /F /IM Applivery-SOAR-Tray.exe /T"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <!-- Relaunches the now-current Tray.exe immediately once install/upgrade
         finishes, via the same Scheduled Task ONLOGON would otherwise only
         fire at next logon — so the new tray icon/notification behavior is
         live right away, with no log off/on and nothing for the user to run
         by hand. -->
    <CustomAction Id="RestartTrayTask"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[System64Folder]schtasks.exe&quot; /Run /TN &quot;Applivery SOAR Tray&quot;"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <InstallExecuteSequence>
      <!-- NOT REMOVE covers both a fresh install and the "install new"
           half of a major upgrade; REMOVE covers both a plain uninstall
           and the "remove old" half of a major upgrade — standard MSI
           REMOVE-property idiom. StopTrayProcess is intentionally
           unconditional (an Action id can only be scheduled once in this
           table) — RemoveFiles runs before InstallFiles in the standard
           sequence, so a single "Before RemoveFiles" placement covers both
           the upgrade and the plain-uninstall case, and is a harmless no-op
           on a fresh install where nothing is running yet. -->
      <Custom Action="StopTrayProcess" Before="RemoveFiles" />
      <Custom Action="RegisterTrayTask" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="RestartTrayTask" After="RegisterTrayTask" Condition="NOT REMOVE" />
      <Custom Action="UnregisterTrayTask" Before="RemoveFiles" Condition="REMOVE" />
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="Applivery SOAR Agent">
      <ComponentRef Id="WatchdogExecutable" />
      <ComponentRef Id="AgentExecutable" />
      <ComponentRef Id="TrayExecutable" />
    </Feature>

  </Package>
</Wix>